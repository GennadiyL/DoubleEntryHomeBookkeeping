{
  "DataAccess": {
    "LocalDirectory": "bin/Debug/net10.0/Assets"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "fileStorage": {
    "Root": "."
  },
  "blobStorage": {
    "StorageUri": "",
    "Retry": {
      "Mode": "Exponential",
      "MaxRetries": 3,
      "Delay": "00:00:00.800",
      "MaxDelay": "00:01:00",
      "NetworkTimeout": "00:01:40"
    }
  }
}
